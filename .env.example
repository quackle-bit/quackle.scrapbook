# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Phase 3+). The anon key is safe for the browser; the service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Studio Appraiser, Phase 3). Server-only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
